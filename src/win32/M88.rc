IDR_MENU_M88 MENU 
BEGIN
    POPUP "&Control"
    BEGIN
        MENUITEM "4MHz",                        IDM_4MHZ
        MENUITEM "8MHz",                        IDM_8MHZ
        MENUITEM SEPARATOR
        MENUITEM "N88-V&1(S) mode",             IDM_N88V1
        MENUITEM "N88-V1(&H) mode",             IDM_N88V1H
        MENUITEM "N88-V&2 mode",                IDM_N88V2
        MENUITEM "N88-V2(C&D) mode",            IDM_N88V2CD
        MENUITEM "&N mode",                     IDM_NMODE
        MENUITEM "N8&0 mode",                   IDM_N80MODE
        MENUITEM "N&80SR mode",                 IDM_N80V2MODE
        MENUITEM SEPARATOR
        MENUITEM "&Burst mode",                 IDM_CPU_BURST
        MENUITEM "&Reset\tF12",                 IDM_RESET
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       IDM_EXIT
    END
    POPUP "&Disk"
    BEGIN
        MENUITEM "Drive &1...",                 IDM_DRIVE_1
        MENUITEM "Drive &2...",                 IDM_DRIVE_2
        MENUITEM SEPARATOR
        MENUITEM "&Change disk image...",       IDM_BOTHDRIVE
        POPUP "&New disk image"
        BEGIN
            MENUITEM "In drive &1...",              IDM_NEWDISK_1
            MENUITEM "In drive &2...",              IDM_NEWDISK_2
            MENUITEM "&Without inserting...",       IDM_NEWDISK_NONE
        END
        MENUITEM SEPARATOR
        POPUP "Disk sound &volume"
        BEGIN
            MENUITEM "&Off",                        IDM_DISKVOL_0
            MENUITEM "&25%",                        IDM_DISKVOL_25
            MENUITEM "&50%",                        IDM_DISKVOL_50
            MENUITEM "&75%",                        IDM_DISKVOL_75
            MENUITEM "&100%",                       IDM_DISKVOL_100
        END
    END
    POPUP "Ta&pe"
    BEGIN
        MENUITEM "&Open...",                    IDM_TAPE
        MENUITEM "N&ew...",                     IDM_TAPE_NEW
        MENUITEM "Re&wind",                     IDM_TAPE_REWIND
        MENUITEM "&Previous gap",               IDM_TAPE_PREV
        MENUITEM "&Next gap",                   IDM_TAPE_NEXT
        MENUITEM SEPARATOR
        MENUITEM "&Record",                     IDM_TAPE_RECORD
        MENUITEM "Tape w&indow",                IDM_TAPEWIN
        MENUITEM SEPARATOR
        POPUP "Tape &speed"
        BEGIN
            MENUITEM "&Normal",                     IDM_TAPESPEED_1
            MENUITEM "x&2",                         IDM_TAPESPEED_2
            MENUITEM "x&4",                         IDM_TAPESPEED_4
            MENUITEM "x&8",                         IDM_TAPESPEED_8
        END
        POPUP "Tape sound &volume"
        BEGIN
            MENUITEM "&Off",                        IDM_TAPEVOL_0
            MENUITEM "&25%",                        IDM_TAPEVOL_25
            MENUITEM "&50%",                        IDM_TAPEVOL_50
            MENUITEM "&75%",                        IDM_TAPEVOL_75
            MENUITEM "&100%",                       IDM_TAPEVOL_100
        END
    END
    POPUP "&Screen"
    BEGIN
        MENUITEM "&Full screen\tAlt+Enter",    IDM_TOGGLEDISPLAY
        POPUP "&Hide menu bar"
        BEGIN
            MENUITEM "In &window",                  IDM_WINHIDEMENU
            MENUITEM "In &full screen",             IDM_FULLHIDEMENU
            MENUITEM SEPARATOR
            MENUITEM "Show &menu\tAlt+M",           IDM_SHOWMENU
        END
        POPUP "Window &scale"
        BEGIN
            MENUITEM "x&1",                         IDM_SCALE_1
            MENUITEM "x&2",                         IDM_SCALE_2
            MENUITEM "x&3",                         IDM_SCALE_3
            MENUITEM "x&4",                         IDM_SCALE_4
