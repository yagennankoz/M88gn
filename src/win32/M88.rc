/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUT DIALOGEX 20, 20, 300, 200
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About M88"
FONT 10, "ＭＳ Ｐゴシック", 0, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,253,2,40,14
    LTEXT           "",IDC_ABOUT_TEXT,25,5,220,33
    ICON            IDI_ICON_M88,IDC_STATIC,3,2,18,20
    EDITTEXT        IDC_ABOUT_BOX,22,39,271,155,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | ES_WANTRETURN | WS_VSCROLL
END

IDD_CONFIG_CPU DIALOGEX 0, 0, 210, 140
STYLE DS_SETFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "CPU"
FONT 9, "ＭＳ Ｐゴシック", 0, 0, 0x1
BEGIN
    GROUPBOX        "速度",IDC_STATIC,5,5,185,40
    LTEXT           "動作周波数(&C)",IDC_STATIC,10,17,49,8
    EDITTEXT        IDC_CPU_CLOCK,60,15,30,12,ES_RIGHT | ES_NUMBER | WS_GROUP
    CONTROL         "Spin1",IDC_CPU_CLOCK_SPIN,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,80,15,11,10
    LTEXT           "MHz",IDC_STATIC,97,17,15,8
